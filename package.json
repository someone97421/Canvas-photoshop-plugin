{
  "name": "canvas-photoshop-plugin",
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "tscheck": "cd typescripts && tsc --noEmit",
    "build": "cross-env NODE_ENV=production node typescripts/_build/esbuild.ts && bash typescripts/_build/package-ccx.sh && bash typescripts/_build/package-all.sh",
    "dev": "cross-env NODE_ENV=development node typescripts/_build/esbuild.ts --watch"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/photoshop": "^25.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.2",
    "esbuild-plugin-external-global": "^1.0.1",
    "glob": "^11.0.1",
    "typescript": "^5.5.4",
    "ws": "^8.18.1"
  },
  "dependencies": {
    "antd": "^5.24.7",
    "chai": "^5.1.2",
    "fast-json-patch": "^3.1.1",
    "jimp": "^1.6.0",
    "mocha": "^11.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  }
}
