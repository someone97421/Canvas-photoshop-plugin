{
  "id": "xuanshang-canvas-photoshop",
  "name": "Xuanshang Canvas",
  "version": "2.0.2",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "allowCodeGenerationFromStrings": true,
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "xuanshang-canvas",
      "label": {
        "default": "Xuanshang Canvas"
      },
      "minimumSize": {
        "width": 330,
        "height": 180
      },
      "maximumSize": {
        "width": 3440,
        "height": 1440
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 680
      }
    }
  ]
}
